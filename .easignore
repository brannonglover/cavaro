# Dependencies (EAS installs these on the build worker)
node_modules/
server/node_modules/

# Local tooling / IDE
.vscode/
.cursor/
.expo/
.claude/

# Secrets
.env
.env*.local

# Backend API — not needed for the mobile app build
server/

# Native build outputs (local gradle / Xcode artifacts)
android/app/build/
android/build/
android/.gradle/
ios/build/
ios/Pods/

# Local working downloads / extracts (LFD/RP image pipelines, etc.)
tmp/
**/*.zip
**/*.aab
**/*.apk

# Misc bulk / non-app
certs/
*.log
.DS_Store
