# EAS uploads the whole repository; the mobile project lives in apps/mobile.
# This file must stay at the repo root — eas-cli only reads it from there.

# Dependencies (EAS installs these on the build worker)
node_modules/

# Local tooling / IDE
.vscode/
.cursor/
.expo/
.claude/

# Secrets
.env
.env*.local

# Not needed for the mobile app build
apps/server/
apps/web/
docs/
tmp/

# Native build outputs (local gradle / Xcode artifacts)
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/ios/build/
apps/mobile/ios/Pods/

# Bulk / non-app
apps/mobile/marketing/
**/*.zip
**/*.aab
**/*.apk
certs/
*.log
.DS_Store
